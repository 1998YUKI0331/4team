# 이 파일은 템플릿이다. 컨테이너가 시작할 때 docker/10-app-config.sh 가
# 포트와 IPv6 리스너 자리를 채워 conf.d/default.conf 로 쓴다.
server {
    listen      __PORT__;
    __LISTEN6__
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    charset_types text/css application/javascript application/json image/svg+xml;

    # 프록시(Railway) 뒤에 있으므로 리다이렉트에 내부 포트를 노출하지 않는다.
    absolute_redirect off;
    server_tokens off;

    gzip            on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml application/xml;

    # 플랫폼 헬스체크
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # 해시가 붙은 번들은 오래 캐시해도 안전하다.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 런타임 설정과 진입 문서는 캐시하지 않는다(키를 바꾸면 바로 반영돼야 한다).
    location = /runtime-config.js {
        add_header Cache-Control "no-store";
        default_type application/javascript;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # 원본 공고문 PDF (한글 파일명 그대로 서빙)
    location /공고문/ {
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # SPA — 없는 경로는 index.html 로
    location / {
        try_files $uri $uri/ /index.html;
    }
}
