# ---------------------------------------------------------------- 로컬 개발
# 네이버 클라우드 플랫폼 > Services > Maps 에서 애플리케이션을 만들고 값을 채운다.
# Web Dynamic Map / Geocoding 서비스를 모두 체크하고, 웹 서비스 URL 에
# http://localhost:5173 을 등록해야 지도가 뜬다.

# 브라우저 번들에 포함됨 (Web Dynamic Map 인증용) — `npm run dev` 에서 쓰인다.
VITE_NAVER_MAP_CLIENT_ID=

# ------------------------------------------------------------------- 배포
# 배포에서는 서버가 /runtime-config.js 를 환경변수로 만들어 내려 준다.
# 아래 이름으로 서비스 환경변수를 넣으면 이미지를 다시 빌드하지 않아도 키가 바뀐다.
#   NAVER_MAP_CLIENT_ID=<Web Dynamic Map Client ID>
#
# 서버/DB 설정 (기본값이 있어 보통 건드릴 필요 없음)
#   PORT=8080                       플랫폼이 자동 주입
#   DB_PATH=/data/app.db            Railway 볼륨 마운트 경로와 맞출 것
#   VISIT_COOLDOWN_MS=1800000       같은 사람의 방문 재집계 간격(기본 30분)

# ------------------------------------------------------- 데이터 파이프라인
# scripts/geocode.mjs 전용 (서버에서만 호출, 커밋 금지)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
